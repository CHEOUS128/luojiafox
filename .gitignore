# ===== 编译产物 =====
build/
# Keil 编译产物（保留 .uvprojx 工程文件）
MDK-ARM/Objects/
MDK-ARM/Listings/
MDK-ARM/*.uvguix.*
MDK-ARM/*.scvd
MDK-ARM/RTE/
Objects/
Listings/
*.obj
*.o
*.d
*.axf
*.hex
*.pdb
*.ilk
*.map
*.exp

# ===== 运行时产物 =====
logs/
*.log

# 客户端现场运行时自动生成的「当前角色」文件：只属于那一台电脑，误提交后
# 另一台 clone 下来会直接变成 B 机，两台都当 B → 小窗永远连不上。
luojiamaster/程序/队友视角.ini

# ===== 大体积资源（GitHub 单文件上限 100MB）=====
# 依赖压缩包：boost 单文件 103.5MB，超过 GitHub 100MB 硬上限，只能排除。
# 其余 8 个小包（≤7.2MB）随仓库上传，unpack_deps.bat 在一台新电脑上仍可用。
luojiamaster/源码/3rdparty_downloads/_archives/boost-*
# 其余 8 个依赖的已解压源码（约 76MB）随仓库上传，新电脑 clone 后可直接编译。
# boost 已解压源码（39MB / 3.8 万个文件）不放进 git：
#   它是第三方上游代码，且这里放不下它自己的压缩包（103.5MB 超 GitHub 上限），
#   缺了它 cmake --preset release 会自动按 CMakeLists.txt 的 URL 下载，见完整复现指南文末。
luojiamaster/源码/3rdparty_downloads/boost/
# 自瞄：演示视频与模型文件
autoaim/**/assets/
autoaim/**/*.mp4
autoaim/**/record_*.mp4

# ===== 压片战争仿真（compression-war）=====
# 裸帧素材：200 帧就 250MB，而且一帧一帧都是可重新生成的
compression-war/素材/
compression-war/**/*.gray
compression-war/**/*.raw
# 中间码流
compression-war/**/*.h264
# 一次跑的产物（summary.txt / per_frame.csv / viewer 的几百张 PNG）
compression-war/runs/
# 外部 ffmpeg 与编译产物（根目录和 scripts\ 里各放一份）
compression-war/ffmpeg.exe
compression-war/cw_sim.exe
compression-war/scripts/ffmpeg.exe
compression-war/scripts/cw_sim.exe
# 编译日志
compression-war/build_log.txt
# 单文件播放器（base64 打包后 7MB+）
compression-war/**/*.html

# 整包离线上传用的临时压缩包（622 MB，远超前 GitHub 100 MB 单文件上限）
# 内容 = 本仓库各目录的快照，属于可重新生成的派生物，不进 git
luojiamaster.zip

# ===== IDE / 系统 =====
.vs/
.vscode/
.idea/
.marscode/
Thumbs.db
desktop.ini

# ===== 临时文件 =====
__pycache__/
*.pyc
*.tmp
*.bak
*~

# ===== 第三方源码里被上面通用规则误伤的文件（必须保留）=====
# directxtk12 自带一个 build/ 目录，里面是 CMake 辅助脚本，不是编译产物
!luojiamaster/源码/3rdparty_downloads/directxtk12/build/
!luojiamaster/源码/3rdparty_downloads/directxtk12/build/**
# protobuf 的 *.map 是 Linux 链接脚本（文本），不是 Keil 的 map 文件
!luojiamaster/源码/3rdparty_downloads/protobuf/src/*.map

# ===== 注意：不要排除 *.lib =====
# luojiamaster/源码/3rdparty/ffmpeg/lib/windows_x86_64/ 下的
# avcodec.lib / avutil.lib / swscale.lib 是必需的预编译静态库
# lower-machine 下的 arm_cortexM4lf_math.lib 也是必需的 CMSIS DSP 库
