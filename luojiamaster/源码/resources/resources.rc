#pragma code_page(65001)
#include "resources.h"
#include "luojiamaster_brand.h"

IDI_APP_ICON ICON "app_icon.ico"

// Windows reads the standard version resource by ordinal 1.
1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
#ifdef _DEBUG
    FILEFLAGS   0x1L
#else
    FILEFLAGS   0x0L
#endif
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", LUOJIAMASTER_TEAM
            VALUE "FileDescription", "luojiamaster 自定义客户端"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", LUOJIAMASTER_PRODUCT
            VALUE "Comments", LUOJIAMASTER_AUTHOR
            VALUE "LegalCopyright", "Original framework © 2026 Yingjie Huang, KaiJin Zhong, ACE Algorithm Team"
            VALUE "OriginalFilename", "luojiamaster.exe"
            VALUE "ProductName", LUOJIAMASTER_PRODUCT
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
