# 换行与编码：Windows 脚本必须 CRLF，否则 cmd 解析 if/label 会出怪问题
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# 二进制：绝不能让 git 做换行转换
*.exe    binary
*.lib    binary
*.ico    binary
*.h265   binary
*.engine binary
*.onnx   binary
*.png    binary
*.jpg    binary

# Markdown documents use UTF-8 without BOM and LF.
*.md text eol=lf
*.gitattributes text eol=lf

# The delivered gimbal sources retain CRLF; CR is not trailing whitespace.
lower-machine/26赛季全向轮步兵/gimbal_project/application/video_forward.c whitespace=trailing-space,space-before-tab,cr-at-eol
lower-machine/26赛季全向轮步兵/gimbal_project/application/video_forward.h whitespace=trailing-space,space-before-tab,cr-at-eol
lower-machine/26赛季全向轮步兵/gimbal_project/application/remote_control.c whitespace=trailing-space,space-before-tab,cr-at-eol
